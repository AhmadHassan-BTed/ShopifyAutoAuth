# .env.example
# =============
# Copy this file to .env and fill in the values for your store and app.
# NEVER commit the real .env file to source control — it is already listed
# in .gitignore.
#
# These variables are read by shopify_auth_adapter at runtime.
# You can also pass the values as keyword arguments to get_access_token()
# or ShopifyClient(), but environment variables are the recommended approach
# for keeping secrets out of your source code.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your store's myshopify.com domain.
# Accepts either "my-store" or "my-store.myshopify.com".
SHOPIFY_SHOP=my-store.myshopify.com

# Client ID from your Shopify Dev Dashboard app's Settings page.
# This value is NOT a secret and may be included in server-side config.
# DO NOT expose it to browser-side JavaScript (even though it is technically
# not sensitive, it limits the attack surface for credential-stuffing).
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client Secret from your Shopify Dev Dashboard app's Settings page.
# THIS IS A SECRET. Treat it like a password:
#   • Never commit it to source control.
#   • Never log it.
#   • Never include it in error messages.
#   • Never expose it to browser-side JavaScript.
#   • Rotate it immediately if it is accidentally exposed.
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Shopify Admin API version. Defaults to the current stable version
# baked into shopify_auth_adapter (currently "2026-07").
# Update this when Shopify releases a new stable version
# (quarterly: -01, -04, -07, -10).
# SHOPIFY_API_VERSION=2026-07
