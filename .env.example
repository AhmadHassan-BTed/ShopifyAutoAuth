# ==============================================================================
# shopify_auth_adapter Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running local development or tests:
#   cp .env.example .env
# WARNING: Never commit real client secrets to version control!
# ==============================================================================

# Target Shopify Store Domain (e.g. my-store.myshopify.com or my-store)
SHOPIFY_SHOP=my-store.myshopify.com

# OAuth Client ID from Shopify Dev Dashboard (App Settings -> Client Credentials)
SHOPIFY_CLIENT_ID=shpca_1234567890abcdef

# OAuth Client Secret from Shopify Dev Dashboard (App Settings -> Client Credentials)
SHOPIFY_CLIENT_SECRET=shpcs_abcdef1234567890abcdef123456

# Optional: Shopify Admin API Version (Defaults to CURRENT_API_VERSION, e.g. 2026-07)
SHOPIFY_API_VERSION=2026-07
